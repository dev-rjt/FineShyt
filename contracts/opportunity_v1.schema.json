{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fineshyt.local/contracts/opportunity_v1.schema.json",
  "title": "Glass-Box Green Insights API Opportunity",
  "type": "object",
  "required": [
    "customer_id",
    "opportunity",
    "product_id",
    "status",
    "propensity",
    "confidence",
    "reason_codes",
    "gate",
    "impact",
    "insight",
    "action",
    "rank_in_customer",
    "rank_score",
    "data_as_of",
    "model_version"
  ],
  "properties": {
    "customer_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,100}$"},
    "opportunity": {
      "enum": [
        "EV_FINANCE",
        "GREEN_HOME_LOAN",
        "SOLAR_FINANCE",
        "PAPERLESS_BANKING",
        "GREEN_INVESTMENTS",
        "GREEN_LOANS"
      ]
    },
    "product_id": {"enum": ["GP01", "GP02", "GP03", "GP04", "GP05", "GP06"]},
    "status": {"enum": ["RECOMMENDED", "SUPPRESSED", "INSUFFICIENT_DATA"]},
    "propensity": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason_codes": {"type": "array", "items": {"$ref": "#/$defs/reason_code"}},
    "gate": {"$ref": "#/$defs/gate"},
    "impact": {"$ref": "#/$defs/impact"},
    "insight": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/insight"}]
    },
    "action": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/action"}]
    },
    "suppression_reason": {
      "type": ["string", "null"],
      "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
    },
    "rank_in_customer": {"type": ["integer", "null"], "minimum": 1},
    "rank_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "data_as_of": {"type": "string", "format": "date"},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 100}
  },
  "additionalProperties": false,
  "$defs": {
    "reason_code": {
      "type": "object",
      "required": ["code", "kind", "label", "plain_text"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"},
        "kind": {"enum": ["DRIVER", "GATE", "DATA_QUALITY"]},
        "label": {"type": "string", "minLength": 1},
        "plain_text": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "failed_rule": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"},
        "message": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["rule_pass", "failed_rules", "rule_version", "note"],
      "properties": {
        "rule_pass": {"type": "boolean"},
        "failed_rules": {"type": "array", "items": {"$ref": "#/$defs/failed_rule"}},
        "rule_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": ["metric", "unit", "low", "central", "high"],
      "properties": {
        "metric": {"enum": ["CO2E_KG", "ENERGY_KWH", "PAPER_SHEETS", "DIGITAL_ADOPTION_PP"]},
        "unit": {"type": "string", "minLength": 1},
        "low": {"type": "number"},
        "central": {"type": "number"},
        "high": {"type": "number"}
      },
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "required": ["id", "value", "unit", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "string", "boolean", "null"]},
        "unit": {"type": ["string", "null"], "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "factor": {
      "type": "object",
      "required": ["factor_id", "activity", "kg_co2e_per_unit", "unit", "source", "source_year"],
      "properties": {
        "factor_id": {"type": "string", "minLength": 1},
        "activity": {"type": "string", "minLength": 1},
        "kg_co2e_per_unit": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"], "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "source_year": {"type": ["integer", "null"], "minimum": 1900}
      },
      "additionalProperties": false
    },
    "impact": {
      "type": "object",
      "required": ["status", "is_estimate", "horizon_months", "method", "metrics", "assumptions", "factors", "missing_inputs"],
      "properties": {
        "status": {"enum": ["OK", "INSUFFICIENT_DATA"]},
        "is_estimate": {"const": true},
        "horizon_months": {"type": "integer", "minimum": 1},
        "method": {"type": "string", "minLength": 1},
        "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
        "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
        "factors": {"type": "array", "items": {"$ref": "#/$defs/factor"}},
        "missing_inputs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "insight": {
      "type": "object",
      "required": ["text", "source", "verified"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "source": {"enum": ["LLM", "TEMPLATE"]},
        "verified": {"const": true}
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["label", "note"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
