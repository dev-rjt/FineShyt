# run_demo.sh creates a private .env with unique local demo credentials.
# Set these values explicitly when configuring a non-local deployment.
BANK_DEMO_ID=
BANK_DEMO_PASSWORD=
CUSTOMER_DEMO_ID=
CUSTOMER_DEMO_PASSWORD=
APP_SESSION_SECRET=
API_BASE_URL=http://127.0.0.1:8000

# Optional grounded wording. The deterministic template works without this.
# Ollama Cloud requires the API key; keep it in this git-ignored file.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_ALLOW_LAN=false
